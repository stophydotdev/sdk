{
  "name": "stophy",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for Stophy, the web data API for AI agents.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://stophy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stophydotdev/sdk.git",
    "directory": "packages/typescript"
  },
  "keywords": [
    "stophy",
    "sdk",
    "ai-agents",
    "web",
    "search"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts && bun ../../scripts/gen-surface.ts",
    "build": "tsup",
    "test": "bun test ../../test/typescript",
    "check-types": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "prepublishOnly": "bun run generate && bun run build"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/bun": "^1.1.14",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.10.2"
  }
}
